#!/bin/sh
# Entry point of the AppImage: point Python, GTK and the bundled tools at the files inside it.
# Deliberately NOT sourced: linuxdeploy's gtk hook, which forces GTK_THEME=Adwaita (ignores your accent colour and
# icon theme) and GDK_BACKEND=x11 (XWayland). The variables below are the parts of it the bundle really needs.
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="$HERE"
export PATH="$HERE/usr/bin:$PATH"
export YTDLP_GTK_ORIG_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"     # programs of the system get this back
export LD_LIBRARY_PATH="$HERE/usr/lib:$HERE/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PYTHONHOME="$HERE/usr"
export PYTHONPATH="$HERE/usr/lib/python3/dist-packages"
export PYTHONNOUSERSITE=1
export GI_TYPELIB_PATH="$HERE/usr/lib/girepository-1.0"
export GIO_EXTRA_MODULES="$HERE/usr/lib/gio/modules"            # dconf: reads your font, theme and accent settings
export GTK_DATA_PREFIX="$HERE"
export GTK_EXE_PREFIX="$HERE/usr"
export GTK_PATH="$HERE/usr/lib/gtk-4.0"
export GSETTINGS_SCHEMA_DIR="$HERE/usr/share/glib-2.0/schemas"
export GDK_PIXBUF_MODULE_FILE="$HERE/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache"
export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
exec "$HERE/usr/bin/python3.14" "$HERE/usr/lib/ytdlp-gtk/main.py" "$@"
